# Campus Placement Eligibility Dashboard - Backend Environment Configuration

# Database Configuration
# Default (zero-config, portable SQLite):
DATABASE_URL=sqlite:///./campus_placement.db

# Or for MySQL (e.g., local MySQL, PlanetScale, Aiven, AWS RDS):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/campus_placement_db

# Or for PostgreSQL (e.g., Render Postgres, Supabase, Neon):
# DATABASE_URL=postgresql://username:password@localhost:5432/campus_placement_db

# Port (Render automatically sets $PORT in production)
PORT=8000
